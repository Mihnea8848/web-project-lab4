# Copy to .env and adjust:  cp .env.example .env

# Zammad image version (ghcr.io/zammad/zammad)
VERSION=7.2.2-0024

# Host port the web UI is published on -> http://localhost:${ZAMMAD_PORT}
ZAMMAD_PORT=8080
ZAMMAD_FQDN=localhost
ZAMMAD_HTTP_TYPE=http
NGINX_SERVER_SCHEME=http

TZ=Europe/Bucharest

# PostgreSQL credentials (change the password!)
POSTGRES_DB=zammad_production
POSTGRES_USER=zammad
POSTGRES_PASS=change-me

# Elasticsearch (set ELASTICSEARCH_ENABLED=false to skip full-text search)
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# Daily backups (kept in the zammad-backup volume)
BACKUP_TIME=03:00
HOLD_DAYS=10

RESTART=unless-stopped
